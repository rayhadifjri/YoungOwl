# ── Database ──────────────────────────────────────────────
POSTGRES_USER=youngowl
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=youngowl
# Local dev (pnpm dev): DB on localhost. In docker compose this is overridden to host "postgres".
DATABASE_URL=postgresql://youngowl:change-me-strong-password@localhost:5432/youngowl

# ── Redis (job queue, used from Phase 3) ──────────────────
REDIS_PASSWORD=change-me-redis-password

# ── API ───────────────────────────────────────────────────
API_PORT=4000
# Set to true behind HTTPS (production). Makes cookies Secure.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# ── Web ───────────────────────────────────────────────────
# Where the Next.js server reaches the API (server side only)
API_INTERNAL_URL=http://localhost:4000

# ── Seed accounts (dummy, lab only — change before deploying) ──
SEED_ADMIN_PASSWORD=Owl-Admin-2026!
SEED_RESEARCHER_PASSWORD=Owl-Research-2026!
SEED_STUDENT_PASSWORD=Owl-Student-2026!

# ── Docker Compose ────────────────────────────────────────
# true = run the dummy seed when the stack starts (wipes and recreates demo data!)
SEED_ON_START=false
WEB_PORT=3000
