{
  "name": "Young Owl",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {},
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Young Owl web", "onAutoForward": "openBrowser" },
    "4000": { "label": "API (internal)", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["Prisma.prisma", "bradlc.vscode-tailwindcss", "esbenp.prettier-vscode"]
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
